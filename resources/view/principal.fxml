<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Moldura do sistema depois do login: menu à esquerda (altura inteira)
     e, à direita, o cabeçalho em cima e a área central (center do "painel"),
     onde o Navegador abre cada tela. Controller: PrincipalController -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.PrincipalController">

    <left>
        <VBox styleClass="menu-lateral">
            <Label text="Internet Banking" styleClass="marca-menu"/>
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="rolagem-menu" VBox.vgrow="ALWAYS">
                <!-- Os botões do menu são criados pelo PrincipalController -->
                <VBox fx:id="menu" spacing="1">
                    <padding><Insets top="0" right="12" bottom="16" left="12"/></padding>
                </VBox>
            </ScrollPane>
        </VBox>
    </left>

    <center>
        <BorderPane fx:id="painel">
            <top>
                <HBox styleClass="cabecalho" alignment="CENTER_LEFT" spacing="12">
                    <padding><Insets top="12" right="24" bottom="12" left="32"/></padding>
                    <Label fx:id="rotuloCliente" styleClass="nome-cliente"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="Sair" onAction="#sair" styleClass="botao-secundario"/>
                </HBox>
            </top>
        </BorderPane>
    </center>

</BorderPane>
